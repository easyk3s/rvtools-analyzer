{
  "apiVersion": 1,
  "id": "odin-azure-local",
  "title": "Azure Local Sizer (ODIN)",
  "symbol": "server.rack",
  "summary": "Size the selected VMs onto Azure Local nodes, and open the same workloads pre-loaded in ODIN for Azure Local.",
  "version": "1.0.0",
  "author": "Eric Steinke",
  "defaultSelection": "poweredOn",
  "parameters": [
    {
      "id": "grouping",
      "type": "choice",
      "group": "Workloads",
      "label": "ODIN workload layout",
      "options": [
        "One grouped workload",
        "One workload per VM"
      ],
      "default": 0,
      "help": "Grouped keeps the ODIN link short. Per-VM falls back to grouped automatically if the link would be too long."
    },
    {
      "id": "rightsize",
      "type": "toggle",
      "group": "Right-sizing",
      "label": "Right-size from observed usage",
      "default": false,
      "help": "Uses CPU and consumed memory from the export plus the buffer. RVTools is a point-in-time snapshot \u2014 validate with performance history."
    },
    {
      "id": "buffer",
      "type": "number",
      "group": "Right-sizing",
      "label": "Buffer",
      "default": 25,
      "min": 0,
      "max": 200,
      "unit": "%"
    },
    {
      "id": "growth",
      "type": "number",
      "group": "Right-sizing",
      "label": "Future growth",
      "default": 0,
      "min": 0,
      "max": 200,
      "unit": "%"
    },
    {
      "id": "nodeCount",
      "type": "choice",
      "group": "Cluster",
      "label": "Node count",
      "options": [
        "Auto (smallest that fits)",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "default": 0
    },
    {
      "id": "resiliency",
      "type": "choice",
      "group": "Cluster",
      "label": "Volume resiliency",
      "options": [
        "Two-way mirror",
        "Three-way mirror"
      ],
      "default": 1,
      "help": "Three-way mirror needs 3 or more nodes. Two-node rows are always evaluated with a two-way mirror."
    },
    {
      "id": "nPlusOne",
      "type": "toggle",
      "group": "Cluster",
      "label": "Keep one node of memory free (N+1)",
      "default": true,
      "help": "Memory must still fit when one node is down for patching or failure."
    },
    {
      "id": "sockets",
      "type": "choice",
      "group": "Node hardware",
      "label": "CPU sockets per node",
      "options": [
        "1",
        "2"
      ],
      "default": 0
    },
    {
      "id": "cores",
      "type": "number",
      "group": "Node hardware",
      "label": "Cores per socket",
      "default": 24,
      "min": 4,
      "max": 128
    },
    {
      "id": "memory",
      "type": "number",
      "group": "Node hardware",
      "label": "Memory per node",
      "default": 192,
      "min": 64,
      "max": 4096,
      "unit": "GiB"
    },
    {
      "id": "vcpuRatio",
      "type": "number",
      "group": "Node hardware",
      "label": "vCPU : physical core ratio",
      "default": 4,
      "min": 1,
      "max": 10
    },
    {
      "id": "reservedMemory",
      "type": "number",
      "group": "Node hardware",
      "label": "Memory reserved for host and infrastructure",
      "default": 32,
      "min": 0,
      "max": 256,
      "unit": "GiB",
      "help": "Local estimate only. ODIN applies its own reserve \u2014 treat ODIN as the authority."
    },
    {
      "id": "diskCount",
      "type": "number",
      "group": "Storage",
      "label": "Capacity disks per node (starting point)",
      "default": 6,
      "min": 2,
      "max": 24
    },
    {
      "id": "autoDisks",
      "type": "toggle",
      "group": "Storage",
      "label": "Add capacity disks per node as needed",
      "default": true,
      "help": "Mirrors ODIN: when storage is the limit, grow the disk count per node (up to the maximum below) before adding nodes."
    },
    {
      "id": "maxDisks",
      "type": "number",
      "group": "Storage",
      "label": "Maximum capacity disks per node",
      "default": 16,
      "min": 2,
      "max": 24,
      "help": "Check this against the chassis you plan to quote."
    },
    {
      "id": "diskSize",
      "type": "choice",
      "group": "Storage",
      "label": "Capacity disk size (TB)",
      "options": [
        "1.92",
        "3.84",
        "7.68",
        "15.36"
      ],
      "default": 1
    }
  ]
}